---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Portfolio', description = 'Welcome to my portfolio' } = Astro.props;
---

<script is:inline>
  document.documentElement.classList.add('dark');
</script>

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="snap-y snap-mandatory h-screen overflow-y-scroll scroll-smooth">

		<!-- Main Content -->
		<main class="min-h-screen">
			<slot />
		</main>
	</body>
</html>
